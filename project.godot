[application]
config/name="LASTLIGHT"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.3")
config/version="0.3.0"

[autoload]
GameState="*res://scripts/GameState.gd"
EventBus="*res://scripts/core/EventBus.gd"
ResourceSystem="*res://scripts/systems/ResourceSystem.gd"
FailureSystem="*res://scripts/systems/FailureSystem.gd"
ScienceLab="*res://scripts/systems/ScienceLab.gd"
NavigationSystem="*res://scripts/systems/NavigationSystem.gd"
ShipAI="*res://scripts/ai/ShipAI.gd"
AlienSignal="*res://scripts/ai/AlienSignal.gd"
Campaign="*res://scripts/campaign/Campaign.gd"
SaveManager="*res://scripts/core/SaveManager.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"

[input]
move_forward={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":87), Object(InputEventKey,"physical_keycode":4194320)]}
move_back={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":83), Object(InputEventKey,"physical_keycode":4194322)]}
move_left={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":65), Object(InputEventKey,"physical_keycode":4194319)]}
move_right={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":68), Object(InputEventKey,"physical_keycode":4194321)]}
interact={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":69)]}
sprint={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":4194325)]}
quick_save={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode": F5)]}
quick_load={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode": F9)]}
